{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "forza-photo-food",
  "main": "src/index.js",
  "compatibility_date": "2026-08-11",
  "workers_dev": true,
  "ai": { "binding": "AI" },
  "vars": {
    "BACKEND_ENABLED": "true",
    "PHOTO_ANALYSIS_ENABLED": "false",
    "PHOTO_FOOD_PROVIDER": "mock",
    "ALLOWED_ORIGIN": "https://gimeneze332-gif.github.io"
  },
  "secrets": {
    "required": ["PAIRING_ADMIN_SECRET"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "PHOTO_FOOD_STATE", "class_name": "PhotoFoodState" }
    ]
  },
  "exports": {
    "PhotoFoodState": { "type": "durable-object", "storage": "sqlite" }
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false }
  }
}
